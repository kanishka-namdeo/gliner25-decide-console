# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Any OpenAI-compatible /chat/completions endpoint works.

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Optional: USD per million tokens, so the panel can show a real cost column.
# Leave at 0 to display $0.00 rather than assert a price that will go stale.
LLM_INPUT_PER_MTOK=0
LLM_OUTPUT_PER_MTOK=0

# Optional: per-request timeout in seconds.
LLM_TIMEOUT_S=60