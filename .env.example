# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Any OpenAI-compatible /chat/completions endpoint works.

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Optional: USD per million tokens, so the panel can show a real cost column.
# Leave these at 0 and the cost column renders "unpriced" — deliberately not
# "$0.00". For a local arm no price means genuinely free; for this arm it means
# nobody supplied one, and the panel says which of the two it is.
LLM_INPUT_PER_MTOK=0
LLM_OUTPUT_PER_MTOK=0

# Optional: HTTP client timeout in seconds. This bounds every call the pooled
# client makes, not a single request.
LLM_TIMEOUT_S=60